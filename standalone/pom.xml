<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
		<artifactId>be.kuleuven.cs.distrinet.sparta.root</artifactId>
		<version>2026.1.0</version>
	</parent>
	<packaging>pom</packaging>
	<artifactId>standalone</artifactId>
	<modules>
		<module>sparta-cli</module>
		<module>sparta-core</module>
		<module>sparta-model</module>
		<module>sparta-io</module>
		<module>sparta-ci</module>
		<module>sparta-analysis</module>
	</modules>
	<name>be.kuleuven.cs.distrinet.sparta.standalone</name>

	<repositories>
		<repository>
			<id>eclipse</id>
			<url>https://repo.eclipse.org/content/groups/releases/</url>
		</repository>
		<repository>
			<id>mvn central</id>
			<url>https://repo1.maven.org/maven2/</url>
		</repository>
	</repositories>

  <profiles>
  	<profile>
  		<id>sign</id>
  		<build>
  		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jarsigner-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.eclipse.cbi.maven.plugins</groupId>
				<artifactId>eclipse-jarsigner-plugin</artifactId>
			</plugin>
		</plugins>
  		</build>
  	</profile>
  </profiles>

</project>