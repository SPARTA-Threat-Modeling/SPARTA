<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
	<artifactId>be.kuleuven.cs.distrinet.sparta.root</artifactId>
	<version>2026.2.0</version>
	<packaging>pom</packaging>
	<name>SPARTA 2026 Configuration</name>
	<inceptionYear>2018</inceptionYear>

	<organization>
		<name>DistriNet</name>
		<url>https://distrinet.cs.kuleuven.be</url>
	</organization>

	<licenses>
		<license>
			<name>EPL-2.0</name>
			<url>https://www.eclipse.org/org/documents/epl-2.0/EPL-2.0.html</url>
			<comments>Eclipse Public License 2.0</comments>
		</license>
	</licenses>

	<modules>
		<module>bundles</module>
		<module>features</module>
		<module>releng</module>
		<module>standalone</module>
	</modules>


	<properties>
		<sparta.version>${project.version}</sparta.version>
		<tycho.version>4.0.13</tycho.version>
		<tycho-extras.version>4.0.13</tycho-extras.version>
		<maven-compiler.version>3.13.0</maven-compiler.version>
		<viatra.version>2.9.1</viatra.version>
		<javadoc.skip>true</javadoc.skip>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<eclipse-release>2025-06</eclipse-release>
		<eclipse-repo.url>https://download.eclipse.org/releases/${eclipse-release}</eclipse-repo.url>
		<slf4j.version>1.7.30</slf4j.version>
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.source>21</maven.compiler.source>
	</properties>


	
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<!--Enable the replacement of the SNAPSHOT version in the final product
				configuration -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-packaging-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<id>package-feature</id>
						<configuration>
							<finalName>${project.artifactId}_${unqualifiedVersion}.${buildQualifier}
							</finalName>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<environments>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
					<!-- Ensure Tycho resolves bundles against JavaSE 17+ (equinox.common requires JavaSE 17) -->
					<executionEnvironment>JavaSE-21</executionEnvironment>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-packaging-plugin</artifactId>
					<version>${tycho.version}</version>
					<dependencies>
						<dependency>
							<groupId>org.eclipse.tycho</groupId>
							<artifactId>tycho-buildtimestamp-jgit</artifactId>
							<version>${tycho-extras.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<timestampProvider>jgit</timestampProvider>
						<jgit.ignore>
							pom.xml
						</jgit.ignore>
						<jgit.dirtyWorkingTree>ignore</jgit.dirtyWorkingTree>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>3.3.0</version>
				</plugin>
				<plugin>
					<groupId>org.eclipse.tycho.extras</groupId>
					<artifactId>tycho-document-bundle-plugin</artifactId>
					<version>${tycho-extras.version}</version>
				</plugin>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-versions-plugin</artifactId>
					<version>${tycho.version}</version>
				</plugin>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-p2-repository-plugin</artifactId>
					<version>${tycho.version}</version>
					<configuration>
						<includeAllDependencies>true</includeAllDependencies>
						<keepNonXzIndexFiles>true</keepNonXzIndexFiles>
						<repositoryName>SPARTA Updatesite</repositoryName>
					</configuration>
				</plugin>

				<plugin>
					<groupId>com.mycila</groupId>
					<artifactId>license-maven-plugin</artifactId>
					<version>5.0.0</version>
					<configuration>
						<properties>
							<owner>DistriNet, KU Leuven</owner>
							<years>2018-2026</years>
							<email>sparta@cs.kuleuven.be</email>
						</properties>
						<aggregate>true</aggregate>
						<licenseSets>
							<licenseSet>
								<header>EPL-header.txt</header>
								<includes>
									<include>**/src/**/be/kuleuven/cs/distrinet/**/*.java</include>
								</includes>
							</licenseSet>
						</licenseSets>
						<!-- <dryRun>true</dryRun> -->
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.11.2</version>
					<configuration>
						<outputDirectory>${project.basedir}/target/docs/${project.version}</outputDirectory>
						<doclint>none</doclint>
						<skip>${javadoc.skip}</skip>
						<links>
							<link>https://download.eclipse.org/modeling/emf/emf/javadoc/2.5.0/</link>
						</links>
						<excludePackageNames>
							be.kuleuven.cs.distrinet.sparta.spartamodel.impl;
							be.kuleuven.cs.distrinet.sparta.spartamodel.tests;
							be.kuleuven.cs.distrinet.sparta.rcp;
							be.kuleuven.cs.distrinet.sparta.spartamodel.presentation;
						</excludePackageNames>
						<author>false</author>
						<encoding>UTF-8</encoding>
						<bottom>
							<![CDATA[Copyright  © 2018–{currentYear} 
 <a href="https://distrinet.cs.kuleuven.be">DistriNet</a>. All rights reserved.]]>
						</bottom>
						<additionalDependencies>
							<dependency>
								<groupId>org.eclipse.emf</groupId>
								<artifactId>org.eclipse.emf.common</artifactId>
								<version>2.40.0</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.emf</groupId>
								<artifactId>org.eclipse.emf.edit</artifactId>
								<version>2.22.0</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.core</groupId>
								<artifactId>org.eclipse.core.resources</artifactId>
								<version>3.7.100</version>
							</dependency>
							<dependency>
								<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
								<artifactId>sparta-core</artifactId>
								<version>${project.version}</version>
							</dependency>

							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>org.eclipse.viatra.addon.databinding.runtime</artifactId>
								<version>${viatra.version}</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>org.eclipse.viatra.addon.databinding.runtime.validation</artifactId>
								<version>${viatra.version}</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>viatra-query-language</artifactId>
								<version>${viatra.version}</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>viatra-query-runtime</artifactId>
								<version>${viatra.version}</version>
							</dependency>
						</additionalDependencies>
					</configuration>
					<!-- <executions>
						<execution>
							<id>mvn-javadoc</id>
							<goals>
								<goal>javadoc</goal>
							</goals>
							<phase>compile</phase>
							<inherited>false</inherited>
						</execution>
						<execution>
							<id>mvn-javadoc-aggregate</id>
							<goals>
								<goal>aggregate</goal>
								<goal>aggregate-no-fork</goal>
							</goals>
							<phase>compile</phase>
							<inherited>false</inherited>
						</execution>
					</executions> -->
				</plugin>
				<!--This plugin's configuration is used to store Eclipse m2e settings
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.apache.maven.plugins
										</groupId>
										<artifactId>
											maven-javadoc-plugin
										</artifactId>
										<versionRange>
											[3.2.0,)
										</versionRange>
										<goals>
											<goal>javadoc</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.eclipse.tycho
										</groupId>
										<artifactId>
											tycho-compiler-plugin
										</artifactId>
										<versionRange>
											[2.7.0,)
										</versionRange>
										<goals>
											<goal>
												validate-classpath
											</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.eclipse.tycho
										</groupId>
										<artifactId>
											target-platform-configuration
										</artifactId>
										<versionRange>
											[2.7.0,)
										</versionRange>
										<goals>
											<goal>target-platform</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>


	<repositories>
		<repository>
			<id>eclipse-release</id>
			<url>${eclipse-repo.url}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>viatra-p2</id>
			<url>https://download.eclipse.org/viatra/updates/release/${viatra.version}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>viatra-mvn</id>
			<url>https://repo.eclipse.org/content/groups/viatra2/</url>
		</repository>
		<repository>
			<id>eclipse-orbit</id>
			<url>https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/${eclipse-release}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>jre-updates</id>
			<layout>p2</layout>
			<url>https://download.eclipse.org/justj/jres/21/updates/release/latest</url>
		</repository>
		<!-- Public, anonymously-readable endpoint for SPARTA's own artifacts. -->
		<repository>
			<id>gitlab-maven</id>
			<url>https://maven.sparta.distrinet-research.be</url>
		</repository>
	</repositories>


	<distributionManagement>
		<repository>
			<id>gitlab-maven</id>
			<url>https://maven.sparta.distrinet-research.be</url>
		</repository>
		<snapshotRepository>
			<id>gitlab-maven</id>
			<url>https://maven-snapshots.sparta.distrinet-research.be</url>
		</snapshotRepository>
	</distributionManagement>
</project>