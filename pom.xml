<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
	<artifactId>be.kuleuven.cs.distrinet.sparta.root</artifactId>
	<version>2026.3.0</version>
	<packaging>pom</packaging>
	<name>SPARTA 2026 Configuration</name>
	<inceptionYear>2018</inceptionYear>

	<organization>
		<name>DistriNet</name>
		<url>https://distrinet.cs.kuleuven.be</url>
	</organization>

	<licenses>
		<license>
			<name>EPL-2.0</name>
			<url>https://www.eclipse.org/org/documents/epl-2.0/EPL-2.0.html</url>
			<comments>Eclipse Public License 2.0</comments>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:https://github.com/SPARTA-Threat-Modeling/SPARTA.git</connection>
		<developerConnection>scm:git:git@github.com:SPARTA-Threat-Modeling/SPARTA.git</developerConnection>
		<url>https://github.com/SPARTA-Threat-Modeling/SPARTA</url>
	</scm>

	<modules>
		<module>bundles</module>
		<module>features</module>
		<module>releng</module>
		<module>standalone</module>
	</modules>


	<properties>
		<sparta.version>${project.version}</sparta.version>
		<tycho.version>4.0.13</tycho.version>
		<tycho-extras.version>4.0.13</tycho-extras.version>
		<viatra.version>2.9.1</viatra.version>
		<jacoco.version>0.8.15</jacoco.version>
		<javadoc.skip>true</javadoc.skip>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<eclipse-release>2025-06</eclipse-release>
		<eclipse-repo.url>https://download.eclipse.org/releases/${eclipse-release}</eclipse-repo.url>
		<!-- JustJ JRE embedded in the product. Floats on the latest 21 release so builds
		     pick up the quarterly security updates; to reproduce an older build, pass the
		     release it used, e.g. -Djustj.release=21.0.12 (listed in the build log). -->
		<justj.release>latest</justj.release>
		<justj-repo.url>https://download.eclipse.org/justj/jres/21/updates/release/${justj.release}</justj-repo.url>
		<!-- Reproducible builds: fixed timestamp for archive entries. Bump per release. -->
		<project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
	</properties>


	
	<build>
		<plugins>
			<!-- Coverage measurement. prepare-agent writes the -javaagent flag into
				the tycho.testArgLine property, which tycho-surefire picks up by
				convention (its argLine parameter maps to that property), so the
				eclipse-test-plugin modules run instrumented. The standalone parent
				adds a second prepare-agent execution targeting plain surefire's
				argLine property. `report` renders target/site/jacoco (XML + HTML)
				wherever an exec file was produced. That only covers the module's own
				classes, which for an eclipse-test-plugin are the tests themselves; the
				production-bundle coverage is the report-aggregate in
				releng/be.kuleuven.cs.distrinet.sparta.coverage. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent-tycho</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
						<configuration>
							<propertyName>tycho.testArgLine</propertyName>
						</configuration>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<!-- Enforce the EPL-2.0 license header on all Java sources. The
				pluginManagement configuration uses aggregate=true with includes
				spanning **/src/**, so a single execution at the root covers the
				entire tree; inherited=false avoids re-running it per module. -->
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<inherited>false</inherited>
				<executions>
					<execution>
						<id>check-license-headers</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<environments>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
					<!-- Ensure Tycho resolves bundles against JavaSE 17+ (equinox.common requires JavaSE 17) -->
					<executionEnvironment>JavaSE-21</executionEnvironment>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- Qualifier support, kept for intermediate (x.y.z.qualifier) versions.
					Released versions carry no .qualifier, so this is inert for them; once
					a version does, Tycho replaces the qualifier with the jgit timestamp of
					the last commit touching the module (pom.xml changes ignored). -->
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-packaging-plugin</artifactId>
					<version>${tycho.version}</version>
					<dependencies>
						<dependency>
							<groupId>org.eclipse.tycho</groupId>
							<artifactId>tycho-buildtimestamp-jgit</artifactId>
							<version>${tycho-extras.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<timestampProvider>jgit</timestampProvider>
						<jgit.ignore>
							pom.xml
						</jgit.ignore>
						<jgit.dirtyWorkingTree>ignore</jgit.dirtyWorkingTree>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
				<plugin>
					<groupId>org.eclipse.tycho.extras</groupId>
					<artifactId>tycho-document-bundle-plugin</artifactId>
					<version>${tycho-extras.version}</version>
				</plugin>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-versions-plugin</artifactId>
					<version>${tycho.version}</version>
				</plugin>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-p2-repository-plugin</artifactId>
					<version>${tycho.version}</version>
					<configuration>
						<includeAllDependencies>true</includeAllDependencies>
						<keepNonXzIndexFiles>true</keepNonXzIndexFiles>
						<repositoryName>SPARTA Updatesite</repositoryName>
					</configuration>
				</plugin>

				<plugin>
					<groupId>com.mycila</groupId>
					<artifactId>license-maven-plugin</artifactId>
					<version>5.0.0</version>
					<configuration>
						<properties>
							<owner>DistriNet, KU Leuven</owner>
							<years>2018-2026</years>
							<email>sparta@cs.kuleuven.be</email>
						</properties>
						<aggregate>true</aggregate>
						<licenseSets>
							<licenseSet>
								<header>EPL-header.txt</header>
								<includes>
									<include>**/src/**/be/kuleuven/cs/distrinet/**/*.java</include>
								</includes>
							</licenseSet>
						</licenseSets>
						<!-- <dryRun>true</dryRun> -->
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.11.2</version>
					<configuration>
						<outputDirectory>${project.basedir}/target/docs/${project.version}</outputDirectory>
						<doclint>none</doclint>
						<skip>${javadoc.skip}</skip>
						<links>
							<link>https://download.eclipse.org/modeling/emf/emf/javadoc/2.5.0/</link>
						</links>
						<excludePackageNames>
							be.kuleuven.cs.distrinet.sparta.spartamodel.impl;
							be.kuleuven.cs.distrinet.sparta.spartamodel.tests;
							be.kuleuven.cs.distrinet.sparta.rcp;
							be.kuleuven.cs.distrinet.sparta.spartamodel.presentation;
						</excludePackageNames>
						<author>false</author>
						<encoding>UTF-8</encoding>
						<bottom>
							<![CDATA[Copyright  © 2018–{currentYear} 
 <a href="https://distrinet.cs.kuleuven.be">DistriNet</a>. All rights reserved.]]>
						</bottom>
						<additionalDependencies>
							<dependency>
								<groupId>org.eclipse.emf</groupId>
								<artifactId>org.eclipse.emf.common</artifactId>
								<version>2.40.0</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.emf</groupId>
								<artifactId>org.eclipse.emf.edit</artifactId>
								<version>2.22.0</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.core</groupId>
								<artifactId>org.eclipse.core.resources</artifactId>
								<version>3.7.100</version>
							</dependency>
							<dependency>
								<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
								<artifactId>sparta-core</artifactId>
								<version>${project.version}</version>
							</dependency>

							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>org.eclipse.viatra.addon.databinding.runtime</artifactId>
								<version>${viatra.version}</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>org.eclipse.viatra.addon.databinding.runtime.validation</artifactId>
								<version>${viatra.version}</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>viatra-query-language</artifactId>
								<version>${viatra.version}</version>
							</dependency>
							<dependency>
								<groupId>org.eclipse.viatra</groupId>
								<artifactId>viatra-query-runtime</artifactId>
								<version>${viatra.version}</version>
							</dependency>
						</additionalDependencies>
					</configuration>
					<!-- <executions>
						<execution>
							<id>mvn-javadoc</id>
							<goals>
								<goal>javadoc</goal>
							</goals>
							<phase>compile</phase>
							<inherited>false</inherited>
						</execution>
						<execution>
							<id>mvn-javadoc-aggregate</id>
							<goals>
								<goal>aggregate</goal>
								<goal>aggregate-no-fork</goal>
							</goals>
							<phase>compile</phase>
							<inherited>false</inherited>
						</execution>
					</executions> -->
				</plugin>
				<!--This plugin's configuration is used to store Eclipse m2e settings
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.apache.maven.plugins
										</groupId>
										<artifactId>
											maven-javadoc-plugin
										</artifactId>
										<versionRange>
											[3.2.0,)
										</versionRange>
										<goals>
											<goal>javadoc</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.eclipse.tycho
										</groupId>
										<artifactId>
											tycho-compiler-plugin
										</artifactId>
										<versionRange>
											[2.7.0,)
										</versionRange>
										<goals>
											<goal>
												validate-classpath
											</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.eclipse.tycho
										</groupId>
										<artifactId>
											target-platform-configuration
										</artifactId>
										<versionRange>
											[2.7.0,)
										</versionRange>
										<goals>
											<goal>target-platform</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>


	<!--
	  NOTE: these <repositories> (the p2 entries below) ARE the target platform of the
	  Tycho build. The PDE target definition in
	  releng/be.kuleuven.cs.distrinet.sparta.product/target-platform.target is used by
	  the Eclipse IDE only and is NOT consumed by any pom. The two are maintained by
	  hand and MUST be kept in sync manually when bumping the Eclipse release, Orbit,
	  VIATRA, or JustJ coordinates here.
	-->
	<repositories>
		<repository>
			<id>eclipse-release</id>
			<url>${eclipse-repo.url}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>viatra-p2</id>
			<url>https://download.eclipse.org/viatra/updates/release/${viatra.version}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>viatra-mvn</id>
			<url>https://repo.eclipse.org/content/groups/viatra2/</url>
		</repository>
		<repository>
			<id>eclipse-orbit</id>
			<url>https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/${eclipse-release}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>jre-updates</id>
			<layout>p2</layout>
			<url>${justj-repo.url}</url>
		</repository>
		<!-- Public, anonymously-readable endpoint for SPARTA's own artifacts. -->
		<repository>
			<id>gitlab-maven</id>
			<url>https://maven.sparta.distrinet-research.be</url>
		</repository>
	</repositories>


	<distributionManagement>
		<repository>
			<id>gitlab-maven</id>
			<url>https://maven.sparta.distrinet-research.be</url>
		</repository>
		<snapshotRepository>
			<id>gitlab-maven</id>
			<url>https://maven-snapshots.sparta.distrinet-research.be</url>
		</snapshotRepository>
	</distributionManagement>
</project>