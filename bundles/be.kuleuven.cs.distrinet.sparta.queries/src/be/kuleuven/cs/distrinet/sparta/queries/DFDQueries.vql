///////////////////// Pattern variants which require crossing the trust boundary and place certain restrictions on the flow/////////////////////
//
// The *Through* pattern variants (contrary to the *to* variants) require the flow to cross a trust
// boundary.
// In addition, the flow has to be between certain types of elements
//
///////////////////// ////////////////////////////////////////////////////////// /////////////////////



//////////////////////// ThreatType finding helper patterns ///////////////
//
// find all applicable threats
private pattern threatApplicable(location : DFDElement, t : ThreatType, pattrn : EString) {
	ThreatType(t);
	ThreatType.enabled(t,true);
	find threatPattern(t,pattrn);
	// there is no parent disabling the threat
	neg find threatTypeParentDisabled(t);
	// there is no parent disabling the pattern
	neg find threatPatternDisabled(t,pattrn);
	// there is no spec disabling the threat
	neg find threatSpecDisable(t);
	// there is no spec disabling the pattern
	neg find threatSpecPatternDisable(t,pattrn);
	// there is no spec disabling the element type
	neg find threatSpecTypeDisable(t,location);
}


//
// check if the pattern applies to the threat
private pattern threatPattern( t : ThreatType, pattrn : EString) {
	find threatTypeParent(parent,t);
	AbstractThreatType.enabled(parent,true);
	AbstractThreatType.patterns(parent, Map); 
    EStringToEBooleanMap.key(Map, pattrn);
    EStringToEBooleanMap.value(Map, true);
}

private pattern threatTypeParentDisabled( t : ThreatType) {
	find threatTypeParent(parent,t);
	AbstractThreatType.enabled(parent,false);
}


// check if an enabled parent specifically disables the pattern
private pattern threatPatternDisabled( t : ThreatType, pattrn : EString) {
	find threatTypeParent(parent,t);
	AbstractThreatType.enabled(parent,true);
	AbstractThreatType.patterns(parent, Map); 
    EStringToEBooleanMap.key(Map, pattrn);
    EStringToEBooleanMap.value(Map, false);
}

private pattern threatTypeParent(parent : AbstractThreatType, type : AbstractThreatType) {
	find threatTypeAncestor+(parent,type);
}

pattern threatTypeAncestor(parent : AbstractThreatType, type : AbstractThreatType) {
	CompositeThreatType.subThreatTypes(parent,type);
} or {
	ThreatType(parent);
	type == parent;
}

//
// match threat types with disabled communication pattern spec
private pattern threatSpecPatternDisable(t : ThreatType, pattrn : EString) {
	// used to check for searching if the pattern is disabled
	find threatTypeParent(parent,t);
	ThreatSpecification(ts);
	ThreatSpecification.threat(ts,parent);
	ThreatSpecification.patterns(ts,Map);
	EStringToEBooleanMap.key(Map, pattrn);
    EStringToEBooleanMap.value(Map, false);
}
//
// match threattypes disabled by a threatspec
private pattern threatSpecDisable(t:ThreatType) {
	find threatTypeParent(parent,t);
	ThreatSpecification(ts);
	ThreatSpecification.threat(ts,parent);
	ThreatSpecification.enabled(ts,false);
}
//
// match elements and threattypes disabled by threatspec
private pattern threatSpecTypeDisable(type:ThreatType, t : DFDElement) {
	Process(t);
	find threatTypeParent(parent,type);
	ThreatSpecification(ts);
	ThreatSpecification.threat(ts,parent);
	ThreatSpecification.types(ts, Map);
	EStringToEBooleanMap.key(Map, "Process");
    EStringToEBooleanMap.value(Map, false);
} or {
	DataStore(t);
	find threatTypeParent(parent,type);
	ThreatSpecification(ts);
	ThreatSpecification.threat(ts,parent);
	ThreatSpecification.types(ts, Map);
	EStringToEBooleanMap.key(Map, "DataStore");
    EStringToEBooleanMap.value(Map, false);
} or {
	ExternalEntity(t);
	find threatTypeParent(parent,type);
	ThreatSpecification(ts);
	ThreatSpecification.threat(ts,parent);
	ThreatSpecification.types(ts, Map);
	EStringToEBooleanMap.key(Map, "ExternalEntity");
    EStringToEBooleanMap.value(Map, false);
} or {
	DataFlow(t);
	find threatTypeParent(parent,type);
	ThreatSpecification(ts);
	ThreatSpecification.threat(ts,parent);
	ThreatSpecification.types(ts,Map);
	EStringToEBooleanMap.key(Map, "DataFlow");
	EStringToEBooleanMap.value(Map, false);
}

///////////////////  supporting patterns ////////////////////
pattern flowContainerDiff(sender: DataFlowEntity, recipient : DataFlowEntity) {
	DataFlowEntity(sender); DataFlowEntity(recipient);
	find communication(sender, _df, recipient);
	
	TrustBoundaryContainer(contain);
	find contains(contain,sender);
	neg find contains(contain,recipient);
} or {
	DataFlowEntity(sender); DataFlowEntity(recipient);
	find communication(sender, _df2, recipient);

	TrustBoundaryContainer(contain);
	find contains(contain,recipient);
	neg find contains(contain,sender);
} 
or {
	DataFlowEntity(sender); DataFlowEntity(recipient);
	find communication(recipient, _df, sender);
	
	TrustBoundaryContainer(contain);
	find contains(contain,sender);
	neg find contains(contain,recipient);
} or {
	DataFlowEntity(sender); DataFlowEntity(recipient);
	find communication(recipient, _df2, sender);

	TrustBoundaryContainer(contain);
	find contains(contain,recipient);
	neg find contains(contain,sender);
}

private pattern contains(outer : DFDContainer, inner : DFDContainer) {
	DFDContainer(outer);
	find containment+(outer,inner);
}

private pattern containment(outer : DFDContainer, inner : DFDContainer) {
	DFDContainer.containedElements(outer, inner);
} or {
	DFDElement(inner);
	outer == inner;
}

private pattern communication(
	sender : DataFlowEntity, 
	flow: DataFlow, 
	recipient : DataFlowEntity
) {
	SenderSpecifiable.sender(sndSpec, sender);
	find sendSpecReachable+(sndSpec, flow);
	RecipientSpecifiable.recipient(rcvSpec, recipient);
	find receiveSpecReachable+(rcvSpec, flow);
}


private pattern sendSpecReachable(spec: SenderSpecifiable, next: SenderSpecifiable) {
	SenderSpecification(spec);
	SenderSpecification.specifiesSenderOf(spec, next);
} or {
	DataFlow(spec);
	spec == next;
}

private pattern receiveSpecReachable(spec: RecipientSpecifiable, next: RecipientSpecifiable) {
	RecipientSpecification(spec);
	RecipientSpecification.specifiesRecipientOf(spec, next);
} or {
	DataFlow(spec);
	spec == next;
}