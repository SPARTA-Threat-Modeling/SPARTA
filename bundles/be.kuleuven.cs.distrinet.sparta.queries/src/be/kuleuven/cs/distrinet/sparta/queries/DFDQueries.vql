///////////////////// Pattern variants which require crossing the trust boundary /////////////////////
//
// The *Through* pattern variants (contrary to the *to* variants) require the flow to cross a trust
// boundary.
//
///////////////////// ////////////////////////////////////////////////////////// /////////////////////
pattern flowThroughComm(location : DataFlow, p : DataFlowEntity, p2 : DataFlowEntity,
							t : ThreatType) {
	DataFlow(location);DataFlowEntity(p);DataFlowEntity(p2);

	find threatApplicable(location,t,"DataFlowThrough");
	find communication(p,location,p2);
	find flowContainerDiff(p,p2);
} or {
	Process(p);
	Process(p2);
	find threatApplicable(location,t,"ProcessThrough*Process");
	find communication(p,location,p2);
	find flowContainerDiff(p,p2);
} or {
	Process(p);
	DataStore(p2);
	find threatApplicable(location,t,"ProcessThrough*DataStore");
	find communication(p,location,p2);
	find flowContainerDiff(p,p2);
} or {
	DataStore(p);
	Process(p2);
	find threatApplicable(location,t,"DataStoreThrough*Process");
	find communication(p,location,p2);
	find flowContainerDiff(p,p2);
} or {
	Process(p);
	ExternalEntity(p2);
	find threatApplicable(location,t,"ProcessThrough*ExternalEntity");
	find communication(p,location,p2);
	find flowContainerDiff(p,p2);
} or {
	ExternalEntity(p);
	Process(p2);
	find threatApplicable(location,t,"ExternalEntityThrough*Process");
	find communication(p,location,p2);
	find flowContainerDiff(p,p2);
}
