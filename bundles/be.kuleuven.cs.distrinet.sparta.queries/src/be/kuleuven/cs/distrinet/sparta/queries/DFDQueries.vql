package be.kuleuven.cs.distrinet.sparta.queries

import "http://distrinet.cs.kuleuven.be/spartamodel"
import "http://www.eclipse.org/emf/2002/Ecore"


pattern flowComm(location : DataFlow, p : DataFlowEntity, p2 : DataFlowEntity,
							t : ThreatType) {
	DataFlow(location);DataFlowEntity(p);DataFlowEntity(p2);
	
	find threatApplicable(location,t,"DataFlow");
	find communication(p,location,p2);
} 

pattern processToProcessComm(location : Process, p2 : Process, df : DataFlow,
							t : ThreatType) {
	Process(location);	Process(p2);	DataFlow(df);
	
	find threatApplicable(location,t,"ProcessToProcess");
	find communication(location,df,p2);
} 
or {
	// add inverse direction
	Process(location);	Process(p2);	DataFlow(df);
	
	find threatApplicable(location,t,"ProcessToProcess*");
	
	find communication(p2,df,location);
}

pattern processToExternalEntityComm(location : Process, p2 : ExternalEntity, df : DataFlow,
									t : ThreatType) {
	Process(location); ExternalEntity(p2); DataFlow(df);
	
	find threatApplicable(location,t,"ProcessToExternalEntity");
	
