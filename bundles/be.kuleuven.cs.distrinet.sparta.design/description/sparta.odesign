        </nodeMappings>
        <edgeMappings name="DataFlowEdge" labelDirectEdit="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='Edit%20Name']" sourceMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='DataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='ExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='ProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification']" targetMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='DataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='ExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='ProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification']" targetFinderExpression="aql:if self.recipientSpecifiedBy = null then self.recipient else self.recipientSpecifiedBy endif" sourceFinderExpression="aql:if self.senderSpecifiedBy = null then self.sender else self.senderSpecifiedBy endif" domainClass="spartamodel.DataFlow" useDomainElement="true" reconnections="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='changeSender'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='changeRecipient']">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2" endsCentering="Both">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="feature:name">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
          <conditionnalStyles predicateExpression="aql:self.sender.eContainer() &lt;> self.recipient.eContainer()">
            <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2" endsCentering="Both">
              <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <centerLabelStyleDescription showIcon="false" labelExpression="aql:self.name">
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              </centerLabelStyleDescription>
            </style>
          </conditionnalStyles>
        </edgeMappings>
        <edgeMappings name="RcpSpecToActual" sourceMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification']" targetMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='DataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='ExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@nodeMappings[name='ProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DataFlowDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification']" targetFinderExpression="aql:if self.recipientSpecifiedBy = null then self.recipient else self.recipientSpecifiedBy endif">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
          <conditionnalStyles predicateExpression="aql: self.getDataFlow().sender.eContainer() &lt;> self.getDataFlow().recipient.eContainer()">
            <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2" endsCentering="Both">
              <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
              <centerLabelStyleDescription showIcon="false" labelExpression="aql:''">
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              </centerLabelStyleDescription>
