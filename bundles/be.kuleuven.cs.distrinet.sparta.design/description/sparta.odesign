            </style>
          </subContainerMappings>
          <subContainerMappings name="DDecomposedEntityNode" semanticCandidatesExpression="aql:self.containedElements->select(el | el.oclIsKindOf(spartamodel::DataFlowEntity) and el.containedElements->notEmpty())" domainClass="spartamodel.DataFlowEntity" reusedBorderedNodeMappings="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification']" reusedNodeMappings="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DProcessNode']" reusedContainerMappings="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subContainerMappings[name='DDecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subContainerMappings[name='DTrustBoundaryContainer']">
            <style xsi:type="style:FlatContainerStyleDescription" arcWidth="200" arcHeight="200" borderSizeComputationExpression="1" showIcon="false" roundedCorner="true">
