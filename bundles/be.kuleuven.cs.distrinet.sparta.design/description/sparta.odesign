<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:properties="http://www.eclipse.org/sirius/properties/1.0.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" xmlns:tool="http://www.eclipse.org/sirius/diagram/description/tool/1.1.0" xmlns:tool_1="http://www.eclipse.org/sirius/description/tool/1.1.0" xmlns:validation="http://www.eclipse.org/sirius/description/validation/1.1.0" name="secdfd" version="12.0.0.2017041100">
  <ownedViewpoints name="DataFlowDiagram" modelFileExtension="uml ecore dfd sdfd security xmi xml sparta securitydfd">
    <validationSet>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="DisconnectedElement" level="ERROR" message="aql:self.name.toUpperFirst()+' is disconnected.'" targetClass="spartamodel::DataFlowEntity">
        <audits auditExpression="aql:not (self.send->isEmpty() and self.receive->isEmpty())"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="SendOnly" level="WARNING" message="aql:self.name + ' only sends but doesn\'t receive any data.'" targetClass="spartamodel::DataFlowEntity">
        <audits auditExpression="aql:not (self.send->notEmpty() and self.receive->isEmpty())"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="Data sink" level="WARNING" message="aql:self.name.toUpperFirst() + ' is a data sink. Who uses this data?'" targetClass="spartamodel::DataFlowEntity">
        <audits auditExpression="aql:not (self.send->isEmpty() and self.receive->notEmpty())"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="DataStoreToDataStore" level="ERROR" message="aql:self.sender.name.toUpperFirst() + ' cannot directly move data to ' + self.recipient.name.toUpperFirst()" targetClass="spartamodel::DataFlow">
        <audits auditExpression="aql: not (self.sender.oclIsKindOf(spartamodel::DataStore) and self.recipient.oclIsKindOf(spartamodel::DataStore))"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="Empty Trust Boundary" level="ERROR" message="aql:self.name.toUpperFirst() + ' is empty.'" targetClass="spartamodel::DFDBoundaryElement">
        <audits auditExpression="aql:not (self.containedElements->isEmpty())"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="Duplicate Trust Boundary" message="aql:'Duplicate TrustBoundary: '+self.name.toUpperFirst() + ' has no elements inside with the exception of other trust boundaries.'" targetClass="spartamodel::DFDBoundaryElement">
        <audits auditExpression="aql:not (self.containedElements->filter(spartamodel::DFDBoundaryElement)->notEmpty() and (not self.containedElements->exists(el | el.oclIsKindOf(spartamodel::DataFlowEntity))))"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="ExternalEntity inside trust boundary" level="WARNING" message="aql:'External entity: ' + self.name.toUpperFirst() + ' is inside the trust boundary.'" targetClass="spartamodel::ExternalEntity">
        <audits auditExpression="aql:not self.eContainer().oclIsKindOf(spartamodel::DFDBoundaryElement)"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="DecompositionCompleteness" level="ERROR" message="aql: self.name + '\'s specialization is incomplete.'" targetClass="spartamodel::DataFlowEntity">
        <audits auditExpression="aql:(self.containedElements->isEmpty() or (self.containedElements->notEmpty() and (self.send->forAll(snd | self.containedElements->filter(spartamodel::SenderSpecification)->exists(spec | spec.specifiesSenderOf = snd)))))"/>
        <audits auditExpression="aql:(self.containedElements->isEmpty() or (self.containedElements->notEmpty() and (self.receive->forAll(rcv | self.containedElements->filter(spartamodel::RecipientSpecification)->exists(spec | spec.specifiesRecipientOf = rcv)))))"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="ReceiveFlowWithoutSpecification" level="ERROR" message="aql:self.name + ' lacks specification of receiving entity.'" targetClass="spartamodel::RecipientSpecifiable">
        <audits auditExpression="aql:self.recipient.containedElements->isEmpty() or self.recipientSpecifiedBy &lt;> null"/>
      </ownedRules>
      <ownedRules xsi:type="validation:SemanticValidationRule" name="SendFlowWithoutSpecification" level="ERROR" message="aql:self.name + ' lacks specification of sending entity.'" targetClass="spartamodel::SenderSpecifiable">
        <audits auditExpression="aql:self.sender.containedElements->isEmpty() or self.senderSpecifiedBy &lt;> null"/>
      </ownedRules>
    </validationSet>
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="DecompositionDiagram" titleExpression="aql:self.name + ' decomposition diagram'" domainClass="spartamodel.DataFlowEntity" enablePopupBars="true">
      <metamodel href="../../be.kuleuven.cs.distrinet.sparta.spartamodel/model/spartamodel.ecore#/"/>
      <validationSet>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="TrustBoundaryInfo" message="aql:self.name + ' is inside a trustboundary. Refer to the DFD view to see which elements are inside or outside of that trust boundary.'" targetClass="spartamodel::DataFlowEntity">
          <audits auditExpression="aql: not(self.eContainer().oclIsKindOf(spartamodel::DFDBoundaryElement))"/>
        </ownedRules>
      </validationSet>
      <defaultLayer name="Default">
        <nodeMappings xsi:type="description_1:NodeMappingImport" name="EExternalEntityNode" semanticCandidatesExpression="aql: (self.send.recipient + self.receive.sender)->reject(el | self.containedElements->includes(el))"/>
        <nodeMappings xsi:type="description_1:NodeMappingImport" name="EProcessNode" semanticCandidatesExpression="aql: (self.send.recipient + self.receive.sender)->reject(el | self.containedElements->includes(el))"/>
        <nodeMappings xsi:type="description_1:NodeMappingImport" name="EDataStoreNode" semanticCandidatesExpression="aql: (self.send.recipient + self.receive.sender)->reject(el | self.containedElements->includes(el))" domainClass="spartamodel.DataStore"/>
        <nodeMappings name="ESolutionNode" domainClass="spartamodel.Solution"/>
        <edgeMappings name="DataFlowEdge" sourceMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@nodeMappings[name='EDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@nodeMappings[name='EExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@nodeMappings[name='EProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subContainerMappings[name='DDecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification']" targetMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@nodeMappings[name='EExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@nodeMappings[name='EDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@nodeMappings[name='EProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subContainerMappings[name='DDecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification']" targetFinderExpression="aql:if self.recipientSpecifiedBy = null then self.recipient else self.recipientSpecifiedBy endif" sourceFinderExpression="aql:if self.senderSpecifiedBy = null then self.sender else self.senderSpecifiedBy endif" domainClass="spartamodel.DataFlow" useDomainElement="true">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2" endsCentering="Both">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="feature:name">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="RcpSpecToActual" sourceMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification']" targetMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subContainerMappings[name='DDecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DRecipientSpecification']" targetFinderExpression="aql:if self.recipientSpecifiedBy = null then self.recipient else self.recipientSpecifiedBy endif">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="SndSpecToActual" sourceMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification']" targetMapping="//@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DDataStoreNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subContainerMappings[name='DDecomposedEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DExternalEntityNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@subNodeMappings[name='DProcessNode'] //@ownedViewpoints[name='DataFlowDiagram']/@ownedRepresentations[name='DecompositionDiagram']/@defaultLayer/@containerMappings[name='DecomposedEntityNode']/@borderedNodeMappings[name='DSenderSpecification']" targetFinderExpression="aql:if self.senderSpecifiedBy = null then self.sender else self.senderSpecifiedBy endif">
          <style sourceArrow="InputArrow" targetArrow="NoDecoration" sizeComputationExpression="2">
