      <genOperations ecoreOperation="spartamodel.ecore#//Asset/getEstimate" body="Estimate e = null; if (tt.getId() != null || tt.getId() != &quot;&quot;) { e = this.getLossMagnitudeByID().get(tt.getId()); } if (e == null) { e = this.getLossMagnitude().get(tt); } if (e == null) { AbstractThreatType parent = tt.getSuperThreatType(); while ( parent != null &amp;&amp; e == null) { if (parent.getId() != null) { e = this.getLossMagnitudeByID().get(parent.getId()); } if (e == null) { e = this.getLossMagnitude().get(parent); } parent = parent.getSuperThreatType(); } } if (e == null) { if (this.getEstimates().size() >= 1) { e = this.getEstimates().get(0); } } return e;">
        <genParameters ecoreParameter="spartamodel.ecore#//Asset/getEstimate/tt"/>
      </genOperations>
    </genClasses>
