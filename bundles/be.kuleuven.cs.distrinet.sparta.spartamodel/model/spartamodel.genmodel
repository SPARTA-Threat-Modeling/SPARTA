      <genOperations ecoreOperation="spartamodel.ecore#//ThreatType/toString" body="return getName();"/>
      <genOperations ecoreOperation="spartamodel.ecore#//ThreatType/getThreatTypeAncestor"
          body="AbstractThreatType parent = this; while ( parent.getSuperThreatType() != null ) { parent = parent.getSuperThreatType(); } return parent;"/>
    </genClasses>
    <genClasses ecoreClass="spartamodel.ecore#//Estimate">
