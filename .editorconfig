# EditorConfig: https://editorconfig.org
# Encodes only conventions verified against the existing sources.
root = true

[*]
charset = utf-8
insert_final_newline = true

# Java sources use tab indentation (Eclipse defaults)
[*.java]
indent_style = tab

# YAML requires spaces; existing CI files use 2-space indentation
[*.{yml,yaml}]
indent_style = space
indent_size = 2
