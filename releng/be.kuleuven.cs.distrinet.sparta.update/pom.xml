<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>be.kuleuven.cs.distrinet.sparta.update</artifactId>
	<packaging>eclipse-repository</packaging>
	<parent>
		<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
		<artifactId>be.kuleuven.cs.distrinet.sparta.releng</artifactId>
		<version>2026.2.0</version>
	</parent>

	<build>
		<plugins>
			<plugin>
				<!-- The p2 update site is published out of band (GitHub Pages
				     composite / release asset), never to a Maven registry. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.7</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>