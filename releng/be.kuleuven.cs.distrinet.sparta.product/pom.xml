<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>be.kuleuven.cs.distrinet.sparta.product</artifactId>
	<packaging>eclipse-repository</packaging>
	<parent>
		<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
		<artifactId>be.kuleuven.cs.distrinet.sparta.releng</artifactId>
		<version>2026.3.0</version>
	</parent>


	<properties>
		<!-- Don't deploy the product zips to a Maven registry. -->
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<!-- The same JustJ JRE release as the jre-updates repository (root pom). -->
					<productRepository>${justj-repo.url}</productRepository>
					<products>
						<product>
							<id>SPARTA</id>
							<rootFolder>SPARTA-${project.version}</rootFolder>
							<rootFolders>
								<macosx>SPARTA.app</macosx>
							</rootFolders>
						</product>
					</products>
					<formats>
						<linux>tar.gz</linux>
					</formats>
				</configuration>
				<executions>
					<execution>
						<id>materialize-products</id>
						<phase>pre-integration-test</phase>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>