<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>be.kuleuven.cs.distrinet.sparta.product</artifactId>
	<packaging>eclipse-repository</packaging>
	<parent>
		<groupId>be.kuleuven.cs.distrinet.sparta</groupId>
		<artifactId>be.kuleuven.cs.distrinet.sparta.releng</artifactId>
		<version>2026.0.0</version>
	</parent>


	<build>
		<plugins>
			<plugin>
				<!-- Don't deploy the product zips -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.7</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<productRepository>https://download.eclipse.org/justj/jres/21/updates/release/</productRepository>
					<products>
						<product>
							<id>SPARTA</id>
							<rootFolder>SPARTA-${project.version}</rootFolder>
							<rootFolders>
								<macosx>SPARTA.app</macosx>
							</rootFolders>
						</product>
					</products>
					<formats>
						<linux>tar.gz</linux>
					</formats>
				</configuration>
				<executions>
					<execution>
						<id>materialize-products</id>
						<phase>pre-integration-test</phase>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>sign</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.cbi.maven.plugins</groupId>
						<artifactId>eclipse-winsigner-plugin</artifactId>
						<version>${eclipse.jarsigner.version}</version>
						<executions>
							<execution>
								<id>sign</id>
								<goals>
									<goal>sign</goal>
								</goals>
								<phase>integration-test</phase>
								<configuration>
									<signerUrl>${eclipse.winsigner.url}</signerUrl>
									<signFiles>
										<signFile>${project.build.directory}/products/SPARTA/win32/win32/x86_64/SPARTA-${project.version}/SPARTA.exe</signFile>
										<!-- <signFile>${project.build.directory}/products/${product-folder}/win32/win32/x86_64/SPARTA-${project.version}/SPARTAc.exe</signFile> -->
									</signFiles>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>